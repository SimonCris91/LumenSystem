# Required server bootstrap settings (fill locally; never commit real values)
LUMEN_API_TOKEN=
LUMEN_BIND=127.0.0.1
LUMEN_PORT=8787
LUMEN_DB=
LUMEN_WEB_ROOT=
LUMEN_ALLOWED_ORIGIN=
LUMEN_COOKIE_SECURE=0
LUMEN_COOKIE_SAMESITE=Lax

# Optional local model settings
OLLAMA_BASE_URL=
OLLAMA_DOCUMENT_MODEL=
LUMEN_WA_WABA_ID=
LUMEN_WA_PHONE_NUMBER_ID=
LUMEN_WA_BUSINESS_ID=
LUMEN_WA_APP_ID=
LUMEN_WA_APP_SECRET=
LUMEN_WA_ACCESS_TOKEN=
LUMEN_WA_VERIFY_TOKEN=
LUMEN_WA_GRAPH_VERSION=
- `LUMEN_SKETCHUP_SOURCE_DIR`: percorso della condivisione SketchUp configurato localmente; non inserire percorsi interni nel repository.
- `LUMEN_SKETCHUP_MAC_DIR`: seconda condivisione SketchUp opzionale, configurata localmente; non inserire percorsi interni nel repository.
LUMEN_SKETCHUP_AGENT_TOKEN=
LUMEN_DOCUMENTI_WINDOWS_DIR=
